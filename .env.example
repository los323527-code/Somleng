# ---------- Required ----------
TELEGRAM_BOT_TOKEN=123456789:replace_me
# Random string (e.g. `openssl rand -hex 24`). The webhook REFUSES requests without it.
WEBHOOK_SECRET=replace_with_random_secret

# ---------- TTS defaults ----------
TTS_MODEL=edge
TTS_VOICE=km-KH-PisethNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_LEADING_SILENCE_SECONDS=0
# DEFAULT_LANG: km | en | ru
DEFAULT_LANG=km
MAX_CHARS=1500
# Keep TTS_TIMEOUT + SEND_TIMEOUT below vercel.json maxDuration (60)
TTS_TIMEOUT_SECONDS=35
SEND_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# ---------- Persistent settings/stats (recommended on Vercel) ----------
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Either pair works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- Speech-to-text (voice/audio -> Khmer text) via somlengsrt.com ----------
# Create a token at https://somlengsrt.com/api-tokens . Never commit it.
SOMLENG_API_TOKEN=
# SOMLENG_API_BASE=https://somlengsrt.com/api/v1
SOMLENG_LANGUAGE=km-KH
# Seconds to wait for the result before showing a "Check result" button (keep < maxDuration 60)
STT_WAIT_SECONDS=30
STT_MAX_MB=20
# Convert Telegram voice (OGG) to MP3 with ffmpeg before upload (1 = yes, 0 = send as-is)
STT_CONVERT_MP3=1

# ---------- Optional ----------
# Telegram user IDs of admins, comma-separated
ADMIN_IDS=

# Inworld TTS (also: pip install -r requirements-extra.txt)
INWORLD_API_KEY=
INWORLD_VOICE=Ashley
INWORLD_LANGUAGE=km-KH
INWORLD_DELIVERY_MODE=BALANCED

# ---------- Only used by setup_webhook.py (run on your computer) ----------
WEBHOOK_URL=https://your-project.vercel.app
